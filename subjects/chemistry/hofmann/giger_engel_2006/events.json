      {
        "entity_id": "pindolol",
        "role": "invention"
      }
    ],
    "sources": [
      {
        "source_id": "giger_engel_2006",
        "page": 5,
        "quote": "F. Troxler, an associate of A. Hofmann, had succeeded in preparing the psilocybin precursor 4-hydroxy-indole (26) when in 1960 the first potent beta-blocker propranolol (Inderal®) (27) was described by the Britisch pharmacologist James Black."
      }
    ]
  },
  {
    "id": "troxler_pindolol_synthesis",
    "event_type": "invention",
    "label": "Synthesis of pindolol by Troxler",
    "date": {
      "display": "1965",
      "precision": "year",
      "sort_start": "1965-01-01",
      "sort_end": "1965-12-31"
    },
    "participants": [
      {
        "entity_id": "f_troxler",
        "role": "subject"
      },
      {
        "entity_id": "pindolol",
        "role": "invention"
      }
    ],
    "sources": [
      {
        "source_id": "giger_engel_2006",
        "page": 5,
        "quote": "In 1965 F. Troxler combined the 4-hydroxy-indole with the side chain of propranolol and obtained pindolol (Visken®) (28) (Fig. 18)."
      }
    ]
  },
