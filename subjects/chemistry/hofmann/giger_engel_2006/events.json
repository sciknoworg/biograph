        "role": "subject"
      },
      {
        "entity_id": "psilocybin",
        "role": "invention"
      }
    ],
    "sources": [
      {
        "source_id": "giger_engel_2006",
        "page": 4,
        "quote": "In the 1958 Hofman elucidated the chemical structure of psilocybin (25), a psychoactive principle isolated from the mushroom Psilocybe Mexicana which has the indole moiety in common with LSD (6) (Fig. 17)."
      }
    ]
  },
  {
    "id": "propranolol_description",
    "event_type": "publication",
    "label": "Propranolol described by James Black",
    "date": {
      "display": "1960",
      "precision": "year",
      "sort_start": "1960-01-01",
      "sort_end": "1960-12-31"
    },
    "participants": [
