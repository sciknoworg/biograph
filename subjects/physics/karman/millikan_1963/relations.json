    "target": "budapest_royal_technical_university",
    "event_id": "graduation_budapest",
    "sources": [
      {
        "source_id": "millikan_1963",
        "page": 1,
        "quote": "Graduating with highest honours as a mechanical engineer from the Budapest Royal Technical University in 1902"
      }
