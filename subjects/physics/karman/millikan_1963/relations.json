    "target": "agard",
    "event_id": "agard_organized",
    "sources": [
      {
        "source_id": "millikan_1963",
        "page": 3,
        "quote": "In 1951 he undertook the organisation of the NATO Advisory Group for Aeronautical Research and Development (AGARD) of which he was chairman until his death."
      }
    ]
  },
