    "event_id": "enrollment_gottingen",
    "sources": [
      {
        "source_id": "millikan_1963",
        "page": 1,
        "quote": "In 1906 von Karman decided to resume his technical studies and accordingly dropped his engineering work to enroll as an advanced student at the University of Gottingen."
      }
    ]
  },
  {
    "id": "worked_aachen",
    "source": "theodore_von_karman",
    "type": "worked_at",
    "target": "university_of_aachen",
    "event_id": "professor_aachen",
    "sources": [
      {
        "source_id": "millikan_1963",
        "page": 1,
        "quote": "1912, when he was made Professor of Aeronautics and Mechanics and Director of the newly established Aeronautical Institute of the University of Aachen."
      }
    ]
  },
  {
    "id": "worked_caltech",
    "source": "theodore_von_karman",
    "type": "worked_at",
    "target": "california_institute_of_technology",
    "event_id": "research_associate_caltech",
    "sources": [
      {
        "source_id": "millikan_1963",
        "page": 1,
        "quote": "In 1928 von Karman became Research Associate of the California Institute of Technology"
      }
    ]
  },
  {
    "id": "directed_galcit",
    "source": "theodore_von_karman",
    "type": "worked_at",
    "target": "galcit",
    "event_id": "director_galcit",
    "sources": [
      {
        "source_id": "millikan_1963",
        "page": 1,
        "quote": "in 1930 settled permanently in California, becoming Director of the Guggenheim Aeronautical Laboratory at the California Institute of Technology"
      }
    ]
  },
  {
    "id": "founded_aerojet",
    "source": "theodore_von_karman",
