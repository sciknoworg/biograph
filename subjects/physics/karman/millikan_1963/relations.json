    "event_id": "aerojet_founded",
    "sources": [
      {
        "source_id": "millikan_1963",
        "page": 2,
        "quote": "von Karman with a few colleagues and friends in 1942 organised the Aerojet Engineering Company"
      }
    ]
  },
  {
    "id": "directed_jpl",
    "source": "theodore_von_karman",
    "type": "worked_at",
    "target": "jet_propulsion_laboratory",
    "event_id": "jpl_established",
    "sources": [
      {
        "source_id": "millikan_1963",
        "page": 2,
        "quote": "Early in 1944 the Army Ordnance Corps arranged to take over the sponsorship of the Laboratory which was then established as the Jet Propulsion Laboratory (JPL) with the mission of conducting a research and development programme on long range missiles, with von Karman as its director."
      }
    ]
  },
