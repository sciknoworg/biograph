        "entity_id": "henry_clifton_sorby",
        "role": "subject"
      },
      {
        "entity_id": "geological_society",
        "role": "venue"
      }
    ],
    "sources": [
      {
        "source_id": "sorby_obituary_1908",
        "page": 2,
        "quote": "On December 16, 1857, he brought before the Geological Society his epoch-making memoir ' On the microscopical structure of crystals '---a memoir which, though neglected, and even ridiculed at the time, laid the foundation of microscopical petrography"
      }
    ]
  },
  {
    "id": "sorby_meteorite_study",
    "event_type": "other",
    "label": "Applied method to study of meteorites",
    "description": "Investigated nature of iron-nickel alloys by examining etched surfaces.",
    "date": {
      "display": "1863",
      "precision": "year",
      "sort_start": "1863-01-01",
      "sort_end": "1863-12-31"
    },
    "participants": [
      {
        "entity_id": "henry_clifton_sorby",
        "role": "subject"
      }
    ],
    "sources": [
      {
        "source_id": "sorby_obituary_1908",
