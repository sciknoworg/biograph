  {
    "id": "sorby_pseudomorphism_memoirs",
    "event_type": "publication",
    "label": "Wrote memoirs on pseudomorphism",
    "description": "Showed origin of Magnesian Limestone and Cleveland ironstone.",
    "date": {
      "display": "1856",
      "precision": "year",
      "sort_start": "1856-01-01",
      "sort_end": "1856-12-31"
    },
    "participants": [
      {
        "entity_id": "henry_clifton_sorby",
        "role": "subject"
      }
    ],
    "sources": [
      {
        "source_id": "sorby_obituary_1908",
        "page": 2,
        "quote": "Important memoirs written by him in 1856 showed that great rock-masses Iike the Magnesian Limestone and the Cleveland ironstone owed their origin to pseudomorphous conversion of the calcite of ordinary limestones into dolomite and chalybite respectively."
      }
    ]
  },
  {
    "id": "sorby_crystals_memoir",
    "event_type": "publication",
    "label": "Presented memoir on microscopical structure of crystals",
    "description": "Brought before the Geological Society; laid foundation of microscopical petrography.",
    "date": {
      "display": "December 16, 1857",
      "precision": "day",
      "sort_start": "1857-12-16",
      "sort_end": "1857-12-16"
    },
    "participants": [
