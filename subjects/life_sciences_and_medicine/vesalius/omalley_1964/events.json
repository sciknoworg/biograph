[
  {
    "id": "vesalius_birth",
    "event_type": "birth",
    "label": "Born",
    "description": "Most likely born at a quarter to six in the morning based on a horoscope cast by Cardano.",
    "date": {
      "display": "31 December 1514",
      "precision": "day",
      "sort_start": "1514-12-31",
      "sort_end": "1514-12-31"
    },
    "participants": [
