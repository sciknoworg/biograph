        "entity_id": "andreas_vesalius",
        "role": "subject"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 1,
        "quote": "From a horoscope cast years later by Girolamo Cardano, it appears that Andreas Vesalius was most likely born at a quarter to six in the morning of 3IDecemberI514."
      }
    ]
  },
  {
    "id": "vesalius_matriculate_louvain",
