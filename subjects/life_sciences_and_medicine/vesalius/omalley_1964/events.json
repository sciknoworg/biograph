  {
    "id": "vesalius_imperial_physician",
    "event_type": "employment_start",
    "label": "Appointed Physician to Imperial Household",
    "description": "Applied to the emperor and received the post after publication of the Fabrica.",
    "date": {
      "display": "1543",
      "precision": "year",
      "sort_start": "1543-01-01",
      "sort_end": "1543-12-31"
    },
    "participants": [
      {
        "entity_id": "andreas_vesalius",
        "role": "subject"
      },
      {
        "entity_id": "imperial_household",
        "role": "employer"
      },
      {
        "entity_id": "charles_v",
        "role": "monarch"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 7,
        "quote": "With the publication of the Fabrica, Vesalius, in his twenty-ninth year and perhaps as yet somewhat youthfully impetuous, decided that his days as an anatomist were over... he applied to the emperor and received the post of physician to the imperial household."
      }
    ]
  },
  {
    "id": "vesalius_pisa_demo",
    "event_type": "public_demonstration",
    "label": "Demonstrations at Pisa",
    "date": {
      "display": "January 1544",
      "precision": "month",
      "sort_start": "1544-01-01",
      "sort_end": "1544-01-31"
    },
    "participants": [
      {
        "entity_id": "andreas_vesalius",
        "role": "subject"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 7,
        "quote": "In fact, in January 1544 he travelled to Pisa for a series of demonstrations at the invitation of Cosimo I, Duke of Tuscany"
      }
    ]
  },
  {
    "id": "vesalius_empyema_procedure",
    "event_type": "invention",
    "label": "Introduced Empyema Drainage",
    "description": "Introduction of surgically induced drainage of empyema.",
    "date": {
      "display": "1547",
      "precision": "year",
      "sort_start": "1547-01-01",
      "sort_end": "1547-12-31"
    },
    "participants": [
      {
