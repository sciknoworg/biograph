        "role": "institution"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 1,
        "quote": "The young Vesalius received his elementary education in Brussels and then he matriculated at the University of Louvain in FebruaryI530 to pursue the arts course"
      }
    ]
  },
  {
    "id": "vesalius_matriculate_paris",
    "event_type": "education",
    "label": "Matriculated at Paris",
    "date": {
      "display": "September 1533",
      "precision": "month",
      "sort_start": "1533-09-01",
      "sort_end": "1533-09-30"
    },
    "participants": [
      {
        "entity_id": "andreas_vesalius",
        "role": "subject"
      },
      {
        "entity_id": "university_paris",
        "role": "institution"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 2,
        "quote": "young Andreas chose to carry on his medical studies in the more illustrious faculty of the University of Paris, matriculating there probably in September1533."
      }
    ]
  },
  {
    "id": "vesalius_leave_paris",
    "event_type": "relocation",
    "label": "Left Paris",
    "description": "Compelled to return to Brussels without a medical degree due to war between France and the Empire.",
    "date": {
      "display": "summer of 1536",
      "precision": "season",
      "sort_start": "1536-06-01",
      "sort_end": "1536-08-31"
    },
    "participants": [
      {
        "entity_id": "andreas_vesalius",
        "role": "subject"
      },
      {
        "entity_id": "brussels",
        "role": "location"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 2,
        "quote": "Vesalius remained in Paris studying for the degree of Bachelor of Medicine until the summer of 1536 when, owing to the outbreak of war between France and the Empire, he became an enemy alien and was compelled to return to Brussels without a medical degree."
      }
    ]
  },
  {
    "id": "vesalius_bachelor_louvain",
    "event_type": "education",
    "label": "Received Bachelor of Medicine",
    "date": {
      "display": "late spring of 1537",
      "precision": "season",
      "sort_start": "1537-03-01",
      "sort_end": "1537-05-31"
    },
    "participants": [
      {
        "entity_id": "andreas_vesalius",
        "role": "subject"
      },
      {
        "entity_id": "university_louvain",
        "role": "institution"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 3,
        "quote": "Returned to the Netherlands, Vesalius enrolled in the medical school of the University of Louvain where, owing to recognition of his medical studies in Paris, he was able to obtain the degree of Bachelor of Medicine, probably in the late spring of I537."
      }
    ]
  },
  {
    "id": "vesalius_doctor_padua",
    "event_type": "education",
    "label": "Received Doctor of Medicine",
    "date": {
      "display": "December 1537",
      "precision": "month",
      "sort_start": "1537-12-01",
      "sort_end": "1537-12-31"
    },
    "participants": [
      {
        "entity_id": "andreas_vesalius",
        "role": "subject"
      },
      {
        "entity_id": "university_padua",
        "role": "institution"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 3,
        "quote": "There is no precise further information about Vesalius until DecemberI537 when he successfully passed his examinations at Padua and received the degree of Doctor of Medicine with what we may call 'highest honours'."
      }
    ]
  },
  {
    "id": "vesalius_chair_padua",
    "event_type": "employment_start",
    "label": "Appointed Chair of Surgery",
    "description": "Given the chair of surgery on the day after receiving his doctorate, with duty of lecturing on anatomy.",
    "date": {
      "display": "December 1537",
      "precision": "month",
      "sort_start": "1537-12-01",
      "sort_end": "1537-12-31"
    },
    "participants": [
      {
        "entity_id": "andreas_vesalius",
        "role": "subject"
      },
      {
        "entity_id": "university_padua",
        "role": "employer"
      }
    ],
    "sources": [
      {
        "source_id": "omalley_1964",
        "page": 3,
        "quote": "It may have been at least partly because of the quality of his examination that on the next day he was given the then relatively unimportant chair of surgery, which carried with it the duty of lecturing on anatomy."
      }
    ]
  },
  {
    "id": "vesalius_charts_published",
    "event_type": "publication",
    "label": "Anatomical Charts Published",
    "date": {
