  {
    "id": "lysosome_discovery_1955",
    "event_type": "invention",
    "label": "Discovered lysosome",
    "date": {
      "display": "1955",
      "precision": "year",
      "sort_start": "1955-01-01",
      "sort_end": "1955-12-31"
    },
    "participants": [
      {
        "entity_id": "christian_de_duve",
        "role": "subject"
      },
      {
        "entity_id": "lysosome",
        "role": "invention"
      }
    ],
    "location": "belgium",
    "sources": [
      {
        "source_id": "opperdoes_2013",
        "page": 1,
        "quote": "Using this approach while working at the Catholic University of Louvain in 1955, de Duve and collaborators reached the conclusion that acid phosphatase and other hydrolases with an acid pH optimum were enclosed in a new organelle, which they proposed to call ''lysosome.''"
      }
    ]
  },
  {
    "id": "lysosome_micrographs",
    "event_type": "other",
    "label": "First saw lysosomes via electron micrographs",
    "date": {
      "display": "Later",
      "precision": "circa",
      "sort_start": "1956-01-01",
      "sort_end": "1960-12-31"
    },
    "participants": [
