{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biograph/schema/event.schema.json",
  "title": "Event",
  "description": "A dateable occurrence involving one or more entities, cited to at least one source. See schema/README.md § 'What counts as an event'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "event_type", "label", "date", "participants", "sources"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable snake_case id, unique within events.json."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "birth", "death",
        "education", "employment_start", "employment_end", "role_change",
        "invention", "patent_filed", "patent_granted",
        "publication", "product_launch", "public_demonstration",
        "conference", "visit", "meeting", "relocation",
        "award", "company_founded", "company_sold", "company_renamed",
        "retirement", "other"
      ]
    },
    "label": {
      "type": "string",
      "description": "Short title, e.g. 'Invention of Atomic Layer Epitaxy'."
    },
    "description": {
      "type": "string",
      "description": "1–3 sentences, close to the source's own account."
    },
    "date": { "$ref": "date.schema.json" },
    "location": {
      "type": "string",
      "description": "Entity id of a 'place' entity, if the source specifies where this happened."
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "role"],
        "properties": {
          "entity_id": { "type": "string" },
          "role": {
            "type": "string",
            "description": "How this entity took part, e.g. 'subject', 'employer', 'collaborator', 'invention', 'awarding_body'."
          }
        }
      }
    },
    "certainty": {
      "type": "string",
      "enum": ["certain", "approximate", "disputed"],
      "default": "certain",
      "description": "'approximate' = source itself hedges (e.g. 'probably around'); 'disputed' = sources disagree."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id"],
        "properties": {
          "source_id": { "type": "string" },
          "page": { "type": "integer" },
          "quote": { "type": "string" }
        }
      }
    }
  }
}
