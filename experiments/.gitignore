# Sandboxed copies of the extraction core, one per run. Rebuilt from the repo by
# harness/sandbox.py and hash-verified against it, so they are reproducible output,
# not source.
.sandbox/

# Benchmark corpora are NOT redistributed here -- same reasoning as data/README.md.
# Each benchmark carries its own licence (see experiments/README.md "Licensing"),
# and several are unresolved. Point an adapter at a local copy with --data-root.
#
# The fetchers themselves are kept: a corpus a paper cites has to be rebuildable from
# the repository, and a reproduction step that points at an ignored file is not one.
corpora/*
!corpora/*.py

# Each corpus also gets a folder holding its provenance: where the release lives, what
# licence it carries, and what a reproduction has to do to obtain it. Git cannot unignore
# a file inside an ignored directory, so the directories are unignored, their contents
# ignored again, and only the README kept. The data beside it never lands in a commit.
!corpora/*/
corpora/*/*
!corpora/*/README.md

# Raw per-document extractions: large, and they embed the benchmark's own source
# text in sources[].quote. Scores and manifests under runs/*/report.* are kept.
runs/*/extractions/
runs/*/cache/
